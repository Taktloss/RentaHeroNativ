# rah_embed_dir(<out.cpp> <ordner> <glob>…): Dateien als Bytefelder in eine C++-Datei, Zugriff über
# rah::embeddedFile("pfad/relativ") (src/app/present/embedded.hpp). Neu erzeugt beim Konfigurieren,
# wenn sich eine Datei ändert (CMAKE_CONFIGURE_DEPENDS).
function(rah_embed_dir out dir)
  set(files)
  foreach(g ${ARGN})
    file(GLOB_RECURSE found CONFIGURE_DEPENDS RELATIVE ${dir} ${dir}/${g})
    list(APPEND files ${found})
  endforeach()
  list(SORT files)
  set(body "// Erzeugt von cmake/embed.cmake – nicht bearbeiten\n#include \"app/present/embedded.hpp\"\n\nnamespace rah {\nnamespace {\n")
  set(table "")
  set(i 0)
  foreach(f ${files})
    file(READ ${dir}/${f} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND body "const unsigned char k${i}[] = {${arr}0};\n")
    string(APPEND table "    {\"${f}\", k${i}, ${bytes}},\n")
    math(EXPR i "${i} + 1")
  endforeach()
  string(APPEND body "struct Entry {\n    const char* path;\n    const unsigned char* data;\n    std::size_t size;\n};\n")
  string(APPEND body "const Entry kFiles[] = {\n${table}};\n}  // namespace\n\n")
  string(APPEND body "std::optional<std::string_view> embeddedFile(std::string_view path) {\n    for (const Entry& e : kFiles)\n        if (path == e.path) return std::string_view(reinterpret_cast<const char*>(e.data), e.size);\n    return std::nullopt;\n}\n\n}  // namespace rah\n")
  if(EXISTS ${out})
    file(READ ${out} old)
  else()
    set(old "")
  endif()
  if(NOT old STREQUAL body)
    file(WRITE ${out} "${body}")
  endif()
endfunction()
