# Bauumgebung für das AppImage: Ubuntu 22.04 (glibc 2.35) – läuft damit auf Ubuntu 22.04+,
# Debian 12+, Fedora 36+ usw. (docs/APPIMAGE.md). Nur Entwicklerpakete; die Bibliotheken des
# Ports (SDL3, FFmpeg, FreeType, unshield, zlib) baut tools/appimage/build.sh aus den Quellen.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++-12 gcc-12 make pkg-config curl ca-certificates xz-utils file python3-pip git \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev libxss-dev \
      libxtst-dev libxkbcommon-dev libwayland-dev wayland-protocols libdecor-0-dev libegl1-mesa-dev \
      libgl1-mesa-dev libgles2-mesa-dev libdrm-dev libgbm-dev libpipewire-0.3-dev libpulse-dev \
      libasound2-dev libdbus-1-dev libudev-dev libibus-1.0-dev \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --no-cache-dir cmake==3.31.6 ninja==1.11.1.4 \
 && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
 && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-12 100 \
 && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-12 100
